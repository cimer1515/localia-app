# Copy this file to .env locally. Never commit .env or private keys.
# ME Network testnet values must be confirmed against the current official RPC before deployment.
ME_EVM_RPC_URL=
ME_EVM_CHAIN_ID=400
ME_DEPLOYER_PRIVATE_KEY=

# Vite variables are public in the browser bundle. RPC URL and chain ID are not secrets.
VITE_ME_NETWORK=testnet
VITE_ME_EVM_RPC_URL=
VITE_ME_EVM_CHAIN_ID=400
VITE_LOCALIA_REGISTRY_ADDRESS=
