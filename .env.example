# Copy to .env on your own computer. NEVER commit .env or share private keys.
# Obtain the official current EVM MAINNET RPC and numeric EVM chain ID from Meta Earth.
# Do not use the Hub/Cosmos chain ID string "me-chain" as an EVM chain ID.
ME_EVM_NETWORK=mainnet
ME_EVM_RPC_URL=
ME_EVM_CHAIN_ID=
ME_DEPLOYER_PRIVATE_KEY=
ME_CONFIRM_MAINNET_DEPLOY=

# Public Vite settings are included in the browser build; do not put secrets here.
VITE_ME_NETWORK=mainnet
VITE_ME_EVM_RPC_URL=
VITE_ME_EVM_CHAIN_ID=
VITE_LOCALIA_REGISTRY_ADDRESS=
