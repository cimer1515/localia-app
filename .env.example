# Browser-safe Supabase public values (ANON key only; never put service role here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Netlify environment variables; never prefix with VITE_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CERT_BUCKET=certificates
HARBOR_SITE_URL=

# Official ME Network EVM settings; confirm RPC and numeric chain ID with ME
ME_EVM_RPC_URL=
ME_EVM_CHAIN_ID=
ME_REGISTRY_ADDRESS=
ME_ISSUER_PRIVATE_KEY=

# Contract deployment settings (only if deploying contract)
ME_DEPLOYER_PRIVATE_KEY=
ME_CONFIRM_MAINNET_DEPLOY=
VITE_ME_EVM_CHAIN_ID=
VITE_LOCALIA_REGISTRY_ADDRESS=
